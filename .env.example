# Copy to .env and fill in. .env is gitignored.

# --- Required ---------------------------------------------------------------
# Postgres on Supabase. DATABASE_URL is the pooled connection (port 6543,
# PgBouncer) used at runtime; DIRECT_URL is the unpooled one (5432) that Prisma
# needs for db push and migrations. Both are in the Supabase dashboard under
# Connect → ORMs → Prisma.
DATABASE_URL=
DIRECT_URL=

# Supabase Auth (email magic link).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Optional -----------------------------------------------------------------
# Both are free, neither takes a credit card, and the app works without either:
# the weather section falls back to the seeded climate normals, and the map
# renders a short "add a key" note in place of the tiles. Nothing else changes.

# weatherapi.com — forecast for trips inside the forecast window.
# Deliberately NOT Open-Meteo, which needs no key at all but whose free tier is
# explicitly non-commercial and so collides with the planned one-time purchase.
WEATHER_API_KEY=

# maptiler.com — map tiles for state-guide place maps, rendered with MapLibre GL.
# Needs the NEXT_PUBLIC_ prefix because the map is drawn in the browser.
# Raw OpenStreetMap tiles are not permitted at app scale and Google Maps now
# requires a billing account, which is why this is the provider.
NEXT_PUBLIC_MAPTILER_KEY=

# --- Trip from a link (Phase B) -------------------------------------------------
# The feature stays on its waitlist page until ANTHROPIC_API_KEY is set. Each import is
# one model call (text or up to four screenshots), limited to 8 attempts per user per
# hour. TRIP_IMPORT_MODEL overrides the model (default claude-sonnet-5-5).
ANTHROPIC_API_KEY=
TRIP_IMPORT_MODEL=

# Place lookup. Defaults to the NEXT_PUBLIC_MAPTILER_KEY above; set MAPTILER_SERVER_KEY
# to use a separate, unrestricted key for server-side lookups.
MAPTILER_SERVER_KEY=

# openrouteservice.org — real driving times between stops. Without it, imported stops are
# shown unordered and the page says so; nothing is ever estimated from straight lines.
ORS_API_KEY=

# --- Affiliate links (Phase C) --------------------------------------------------
# Each is the exact query string the supplier's affiliate program gives you, appended to
# that supplier's search links. Unset = a plain link, and the page says no commission is
# earned. A link is only ever labelled "Affiliate link" when a tag was appended.
# Invalid values (anything but name=value pairs) are ignored. Google Flights/Hotels have no
# program and are never tagged.
# e.g. AFFILIATE_BOOKING=aid=123456
#      AFFILIATE_GETYOURGUIDE=partner_id=ABC123
#      AFFILIATE_VIATOR=pid=P00012345&mcid=42383&medium=link
AFFILIATE_KAYAK=
AFFILIATE_BOOKING=
AFFILIATE_GETYOURGUIDE=
AFFILIATE_VIATOR=

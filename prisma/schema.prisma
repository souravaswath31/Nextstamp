// NextStamp data model
//
// Postgres, hosted on Supabase — also provides auth (see src/lib/currentUser.ts).
// DATABASE_URL is the pooled connection (runtime queries); DIRECT_URL is the
// unpooled connection Prisma needs for db push / migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// id matches the Supabase auth user's id (auth.users.id) — set explicitly at
// signup (see completeOnboarding in src/lib/actions.ts), not autogenerated,
// so this row and the Supabase-managed auth identity always share one id.
model User {
  id               String    @id
  email            String    @unique
  name             String
  passportCountry  String
  // The passport's own expiry date. Optional because every existing user
  // predates this field, and because someone browsing content shouldn't be
  // forced to hand it over — but without it the single most common real
  // trip blocker ("passport must be valid 6 months beyond entry") can't be
  // checked at all. See src/lib/readiness.ts.
  passportExpiry   DateTime?
  homeBaseLocation String?
  createdAt        DateTime  @default(now())

  heldDocuments      HeldDocument[]
  trips              UserTrip[]
  tripCollaborations TripCollaborator[]
  expensesPaid       TripExpense[]
  packingClaims      TripPackingItem[]
  savedPlaces        TripSavedPlace[]
  entitlement        Entitlement?
  tripImports        TripImport[]
}

// A visa, residency permit, or similar document the user holds beyond
// their passport — this is what powers the "visa cascade" feature
// (e.g. an Indian passport + a valid US H1B visa unlocks entry to a
// third set of countries that neither alone would).
model HeldDocument {
  id         String    @id @default(cuid())
  userId     String
  type       String // "visa" | "residency_permit" | "green_card" ...
  country    String // issuing country, e.g. "USA"
  subtype    String? // e.g. "H1B", "B1/B2", "Schengen"
  validUntil DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Itinerary {
  id                  String   @id @default(cuid())
  title               String
  // URL slug for the public /itineraries/[slug] pages. Derived from the title
  // (src/lib/slug.ts) and assigned in the seed; unique, so a collision gets a
  // numeric suffix rather than two pages fighting over one URL.
  slug                String   @unique
  category            String // comma-separated tags, e.g. "nature,splurge"
  region              String
  countries           String // comma-separated ISO-ish country names
  durationDaysMin     Int
  durationDaysMax     Int
  bestTimeDescription String
  bestTimeMonths      String // comma-separated month names
  description         String
  coverImageUrl       String?
  costTier            String // "budget" | "mid" | "splurge"
  isPublic            Boolean  @default(true)
  createdBy           String? // null = seeded/admin content
  createdAt           DateTime @default(now())
  relatedStateSlugs   String? // comma-separated StateGuide.slug values — for
  // domestic itineraries whose food/drink/culture
  // depth already lives in a state guide, so we
  // link out instead of duplicating the research

  days  ItineraryDay[]
  notes ItineraryNote[]
  trips UserTrip[]
}

model ItineraryDay {
  id                String  @id @default(cuid())
  itineraryId       String
  dayNumber         Int
  title             String
  activities        String // pipe-separated list
  driveTime         String?
  lodgingSuggestion String?
  coffeeWifiSpot    String?
  // Geocoded once at authoring time from the day's title, constrained to the
  // itinerary's own country (see scripts/geocode_places.py). Null for the many
  // days whose title is an activity rather than a place ("Arrive and
  // acclimatise") — those are simply absent from the route map rather than
  // pinned somewhere plausible-looking.
  latitude          Float?
  longitude         Float?
  // The town where you'd actually EAT on this day, matched to a RoadEatStop.
  // Not the same as the day's title: titles are often an activity ("Lost Mine
  // Trail", "Cadillac Mountain") and nobody eats on a trail — the answer is the
  // gateway town (Terlingua, Bar Harbor). Null for days with no realistic
  // answer, e.g. "Depart".
  eatTown           String?

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
}

// Same shape and purpose as StatePlace's food_culture entries, scoped to
// a specific trip's destination country rather than a US state — the
// international itineraries had zero content here even though the state
// guides all do, since food/drink/culture was added to the pattern after
// the itineraries were first built.
model ItineraryNote {
  id          String  @id @default(cuid())
  itineraryId String
  category    String // "food_culture" for now
  placeType   String? // "dish" | "drink" | "tradition" | "culture"
  name        String
  description String

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
}

// Rules keyed by (passport, destination). requiresHeldDocumentCountry
// models the cascade: when set, this rule only applies to a user who
// also holds a live document issued by that country (e.g. "USA").
model VisaRule {
  id                          String   @id @default(cuid())
  passportCountry             String
  destinationCountry          String
  visaType                    String // "visa-free" | "visa-on-arrival" | "e-visa" | "advance-visa-required"
  requiresHeldDocumentCountry String?
  conditionsText              String
  maxStayDays                 Int?
  feeNotes                    String?
  sourceUrl                   String?
  lastVerifiedDate            DateTime

  @@unique([passportCountry, destinationCountry, requiresHeldDocumentCountry])
}

model UserTrip {
  id             String  @id @default(cuid())
  userId         String
  itineraryId    String?
  title          String
  status         String  @default("idea") // "idea" | "planning" | "booked" | "completed"
  customDaysJson String // JSON override of the day-by-day plan (source of truth once a trip is created)
  costTier       String  @default("mid")
  shareToken     String? @unique
  // Read-only public link, deliberately separate from shareToken: anyone
  // holding shareToken can join the trip as an editing collaborator, so it
  // must never be the thing you post publicly. publicToken only ever reads.
  publicToken    String? @unique
  isPublic       Boolean @default(false)

  // Planned travel dates — the forward-looking pair. startedDate/
  // completedDate below are retrospective ("I went", "I got back") and
  // predate these; don't conflate them. Everything date-aware in the app
  // (entry readiness, holidays during the stay, countdown, weather window)
  // reads startDate/endDate.
  startDate          DateTime?
  endDate            DateTime?
  // Where the trip actually goes. An itinerary-derived trip can infer this
  // from Itinerary.countries, but a from-scratch trip had nowhere to say it,
  // which made every destination-aware feature unanswerable.
  destinationCountry String?

  startedDate   DateTime?
  completedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  itinerary     Itinerary?         @relation(fields: [itineraryId], references: [id])
  collaborators TripCollaborator[]
  packingItems  TripPackingItem[]
  expenses      TripExpense[]
  savedPlaces   TripSavedPlace[]
  imports       TripImport[]

  @@index([userId])
}

// A place pulled into a trip from the content library — a state-guide place,
// or anything else worth remembering.
//
// This is the bridge that was missing: NextStamp had 840 curated places and
// 114 itineraries, and the only thing a person could actually pull into a plan
// was a whole itinerary. Reading about Maroon Bells in the Colorado guide and
// then retyping it into a day was the entire workflow.
//
// Deliberately a holding list rather than a direct write into a day: when
// you're browsing you rarely know yet which day something belongs on, and
// forcing that choice at save time is what makes people not bother. Slotting a
// saved place into a day is a separate, later action (addSavedPlaceToDay).
model TripSavedPlace {
  id         String   @id @default(cuid())
  tripId     String
  name       String
  note       String?
  // Where it came from, so the trip can link back to the guide it was read in.
  sourceKind String? // "state_place" | "country" | "manual"
  sourceSlug String? // e.g. the StateGuide slug, for a link back
  // For places imported from a post (sourceKind "import_post"): the post's own
  // words that mention it. Null for everything else.
  quote      String?
  latitude   Float?
  longitude  Float?
  // Set once it's been slotted into a day, so it can show as used without
  // disappearing — people want to see what they've already placed.
  usedOnDay  Int?
  addedById  String?
  createdAt  DateTime @default(now())

  trip    UserTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  addedBy User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([tripId, name])
}

// The packing list, made stateful. src/lib/packing.ts still generates the
// starting list from the itinerary's category tags; these rows are what
// happens after — ticked off, claimed by a co-traveler, added by hand.
// Rows are created lazily on first interaction, not eagerly at trip
// creation, so the generated list stays the source of truth until someone
// actually touches it.
model TripPackingItem {
  id        String   @id @default(cuid())
  tripId    String
  label     String
  category  String   @default("general") // matches the group headings in packing.ts
  packed    Boolean  @default(false)
  // Which co-traveler said they'd bring it — the "who's bringing the
  // adapter" problem. Null means nobody has claimed it.
  claimedBy String?
  isCustom  Boolean  @default(false) // false = came from the generated list
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  trip     UserTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  claimant User?    @relation(fields: [claimedBy], references: [id], onDelete: SetNull)

  @@unique([tripId, label])
}

// Real spend logged against the trip, next to the estimate src/lib/costs.ts
// produces. amountMinor is an integer in the currency's minor unit (cents,
// yen, etc.) — never a float, because summing floats and then splitting
// them between people is how you end up a penny off forever.
model TripExpense {
  id             String   @id @default(cuid())
  tripId         String
  paidById       String
  label          String
  category       String // "lodging" | "food" | "transport" | "activities" | "other"
  amountMinor    Int
  currency       String   @default("USD") // ISO 4217
  // Amount converted to USD at log time, so a mixed-currency trip can still
  // be totalled. Stored rather than recomputed because the rate that applied
  // on the day you spent it is the honest one.
  amountMinorUsd Int?
  fxRate         Float?
  spentOn        DateTime
  // Comma-separated User ids this expense is split between (always includes
  // paidById). Comma-separated rather than a join table to match the existing
  // convention in this schema (Itinerary.countries, .category) — splits are
  // small and always read whole.
  splitBetween   String
  createdAt      DateTime @default(now())

  trip   UserTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy User     @relation(fields: [paidById], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// Where to eat along a road-trip route.
//
// NextStamp had food content, but it answered the wrong question: 222 state
// entries about what a state TASTES like (green chile, Palisade peaches) and
// nothing about where to stop for lunch on day 3. A road-tripper — and
// everything in this app is a road trip — needs a few real eats per stop.
//
// regionKey is a state slug ("texas") or a country name for international
// routes, matching how Itinerary.relatedStateSlugs / .countries already work.
//
// This is the most perishable data in the project: restaurants close, change
// hours and go seasonal. Every eat therefore carries openEvidence (what was
// seen, and where) and every stop carries lastVerifiedDate, and the UI says so
// rather than presenting it as permanent. See CLAUDE.md, "Road food".
model RoadEatStop {
  id               String   @id @default(cuid())
  regionKey        String
  town             String
  // Logistics where the honest answer is "options are thin" — e.g. no dining
  // inside a national park, nearest full meal 11 miles on. Sourced.
  note             String?
  noteSourceUrl    String?
  lastVerifiedDate DateTime

  eats RoadEat[]

  @@unique([regionKey, town])
}

model RoadEat {
  id           String  @id @default(cuid())
  stopId       String
  name         String
  kind         String // "diner" | "bbq" | "bakery" | "cafe" | "brewery" | "market" | "regional" | "dessert" | "drive_in" | "seafood"
  meal         String // "breakfast" | "lunch" | "dinner" | "snack" | "any"
  whatToOrder  String
  why          String
  priceTier    String? // "$" | "$$" | "$$$" — only when a source states it
  // Closed days, seasons, cash-only — only as stated by a source. Null means
  // nothing was stated, NOT "open year-round".
  hoursNote    String?
  // One sentence: what proves it is currently operating, and where it was seen.
  openEvidence String
  sourceUrl    String
  sourceName   String
  sortOrder    Int     @default(0)

  stop RoadEatStop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([stopId])
}

// Everything a traveller needs to know about a destination that isn't the
// visa answer: passport validity rules, health, money norms, plugs,
// emergency numbers, transit, connectivity. One row per country, seeded
// from data/country-facts-seed.json through the same research pipeline the
// visa rules use — so every field carries a source URL and a verified date,
// and the UI surfaces staleness rather than hiding it.
model CountryFact {
  id              String  @id @default(cuid())
  country         String  @unique // matches VisaRule.destinationCountry exactly
  iso2            String
  currencyCode    String
  currencyName    String
  primaryTimezone String // IANA zone, e.g. "Asia/Tokyo"
  timezoneLabel   String
  timezoneNote    String?

  // Entry readiness — the fields src/lib/readiness.ts checks a real trip against.
  passportValidityRule              String
  passportValidityMonthsBeyondEntry Int      @default(0)
  passportValidityBasis             String   @default("none") // "entry" | "exit" | "duration-of-stay" | "none"
  blankPagesRequired                Int?
  // Tri-state on purpose. true = the destination's own rules state it;
  // false = confirmed not required; null = nobody could confirm either way.
  // Collapsing null into false would silently tell a traveller "no return
  // booking needed" on the strength of a failed search, which is the wrong
  // direction to be wrong in. Peru is the record that forced this.
  onwardTicketRequired              Boolean?
  entryRequirementNotes             String?
  passportSourceUrl                 String?

  healthRequiredVaccinations    String  @default("") // comma-separated
  healthRecommendedVaccinations String  @default("")
  healthMalariaRisk             String?
  healthNotes                   String?
  healthSourceUrl               String?

  moneyCardAcceptance String?
  moneyCashCulture    String?
  moneyTipping        String?
  moneyAtmNotes       String?
  moneySourceUrl      String?

  powerPlugTypes   String  @default("") // comma-separated, e.g. "A,B"
  powerVoltage     String?
  powerFrequency   String?
  powerAdapterNote String?
  powerSourceUrl   String?

  emergencyPolice        String?
  emergencyAmbulance     String?
  emergencyFire          String?
  emergencyUniversal     String?
  emergencyTouristPolice String?
  emergencyNotes         String?
  emergencySourceUrl     String?

  transitSummary    String?
  transitPassesJson String  @default("[]") // [{name, covers, worth_it, buy_before_arrival}]
  transitSourceUrl  String?

  esimSupported           Boolean?
  localSimNotes           String?
  connectivityCost        String?
  simRegistrationRequired Boolean?
  connectivitySourceUrl   String?

  climateReferenceCity String?
  // Coordinates of climateReferenceCity, geocoded once at authoring time.
  // Gives the country guide a map anchor and gives a trip a location to centre
  // on when its destination is a country rather than a place.
  latitude             Float?
  longitude            Float?
  climateSourceUrl     String?
  phrasesLanguage      String?

  sources          String   @default("") // pipe-separated URL list
  lastVerifiedDate DateTime

  climate CountryClimate[]
  phrases CountryPhrase[]
}

// Month-by-month climate, replacing the free-text "best time to visit" with
// something a trip's actual dates can be checked against.
model CountryClimate {
  id                String  @id @default(cuid())
  countryFactId     String
  monthNumber       Int // 1-12, so ordering doesn't depend on parsing a name
  month             String
  avgHighC          Int?
  avgLowC           Int?
  precipitationNote String?
  crowdNote         String?
  rating            String  @default("shoulder") // "peak" | "shoulder" | "low" | "avoid"

  countryFact CountryFact @relation(fields: [countryFactId], references: [id], onDelete: Cascade)

  @@unique([countryFactId, monthNumber])
}

// A short curated phrasebook. Curated rather than machine-translated on
// purpose: a wrong phrase is embarrassing at best and offensive at worst,
// and 14 hand-checked phrases beat a translation API for this use.
model CountryPhrase {
  id            String  @id @default(cuid())
  countryFactId String
  phraseEn      String
  local         String
  romanization  String?
  sortOrder     Int     @default(0)

  countryFact CountryFact @relation(fields: [countryFactId], references: [id], onDelete: Cascade)
}

// A co-traveler who can view and edit a trip they don't own — added via the
// trip's shareToken invite link (see joinTripViaToken in actions.ts). Real,
// linked accounts rather than the old coTravelers free-text field, so
// editing rights and Realtime access can actually be scoped to them.
model TripCollaborator {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  createdAt DateTime @default(now())

  trip UserTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])

  @@index([userId])
}

// State/destination guides — a curated place directory, distinct from the
// day-by-day Itinerary model above. A guide is "here's everything worth
// knowing about Colorado," not a fixed trip plan; the person builds their
// own trip from it. One state per StateGuide, many places per state.
model StateGuide {
  id                    String   @id @default(cuid())
  name                  String // "Colorado"
  slug                  String   @unique // "colorado"
  region                String // "Mountain West"
  heroTagline           String // one line capturing the state's character
  heroDescription       String
  bestTimeToVisit       String
  altitudeOrClimateNote String? // e.g. altitude acclimatization, hurricane season — whatever's relevant
  permitsNote           String? // timed-entry permits, reservations required, etc.
  gearNote              String?
  terrain               String   @default("mountain") // "mountain" | "desert" | "coast" | "plains" | "forest" — picks the hero illustration motif
  createdAt             DateTime @default(now())

  places StatePlace[]
}

// category: "amazing" (hiking/adventure/drives) | "common" (top attractions)
// | "hidden" (hidden gems)
model StatePlace {
  id           String  @id @default(cuid())
  stateGuideId String
  category     String
  name         String
  placeType    String? // "hike" | "drive" | "attraction" | "town" | "park" — flavor, optional
  description  String
  tip          String?
  nearestTown  String?
  sortOrder    Int     @default(0)
  // Geocoded ONCE at authoring time by scripts/geocode_places.py and stored in
  // data/state-guides-seed.json — never looked up at request time. Nominatim
  // allows 1 request/second and explicitly forbids using it for autocomplete,
  // so a per-render lookup would both break its terms and be far too slow.
  // Null means no confident match was found; the map simply omits that pin
  // rather than dropping a marker in the wrong place.
  latitude     Float?
  longitude    Float?

  stateGuide StateGuide @relation(fields: [stateGuideId], references: [id], onDelete: Cascade)
}

// People asking to be told when a feature ships, or when their passport is
// added. Nothing is emailed from this table yet. `interest` is one of
// flights | hotels | activities | passport | wallet. The unique key is what
// makes signing up twice for the same thing a no-op instead of a duplicate row.
model WaitlistSignup {
  id               String   @id @default(cuid())
  email            String
  interest         String
  requestedPassport String?
  createdAt        DateTime @default(now())

  @@unique([email, interest])
}

// A savings target for a trip. NextStamp never holds this money and never
// connects to a bank: it is a notebook of what the user says they have set
// aside, nothing more. Amounts are integers in the minor unit of `currency`.
model TripFund {
  id          String   @id @default(cuid())
  userId      String
  name        String
  currency    String   @default("USD")
  targetMinor Int
  tripId      String?
  createdAt   DateTime @default(now())

  entries TripFundEntry[]

  @@index([userId])
}

// One manual deposit (positive) or withdrawal (negative) the user recorded.
model TripFundEntry {
  id          String   @id @default(cuid())
  fundId      String
  amountMinor Int
  note        String?
  enteredOn   DateTime @default(now())

  fund TripFund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
}

// What a user has paid for (Phase D). One row per user: the $5 one-time purchase,
// or a manual grant (source "grant") for people who should have access without
// paying. Only written by the Stripe webhook / return-page verification, or by
// prisma/grant-entitlement.ts. status "refunded" turns access off again.
model Entitlement {
  id                    String   @id @default(cuid())
  userId                String   @unique
  // "trialing" | "active" | "past_due" | "canceled" | "refunded" (plus Stripe's other subscription states)
  status                String   @default("active")
  source                String // "stripe" | "grant"
  stripeSessionId       String?  @unique
  stripePaymentIntentId String?  @unique
  amountMinor           Int?
  currency              String?
  createdAt             DateTime @default(now())

  // Mirrors the Stripe subscription (30-day trial, then yearly). Stripe is the source of truth.
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  trialEnd             DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
}

// A trip drafted from a social post (Phase B). Holds only what the user needs to
// see where the stops came from, and to delete it: the link, the public text we
// read from it (caption / oEmbed title), or nothing for screenshots, which are
// processed in memory and never stored. Third-party video is never downloaded.
// Deleting the import row deletes the source data; the trip itself stays.
model TripImport {
  id         String   @id @default(cuid())
  userId     String
  tripId     String?
  sourceKind String // "link" | "text" | "screenshots"
  platform   String? // "youtube" | "tiktok" | "instagram" for links
  sourceUrl  String?
  sourceText String?
  createdAt  DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip UserTrip? @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---- Escape Hatch (the multiplayer trip game) ----------------------------------------------
// A game is a short-lived room that friends join with a code. No accounts: each player holds a
// random token. Games are deleted a week after they were made.
model EscapeGame {
  id        String   @id @default(cuid())
  code      String   @unique
  // lobby | duels | draw | vote | pact | done
  phase     String   @default("lobby")
  config    Json // { fromState, days, month, reach }
  deck      Json? // the dealt cards (snapshots)
  result    Json? // vibe, budget, roles, the count, the winner
  seed      Int
  redraws   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  players EscapePlayer[]

  @@index([createdAt])
}

model EscapePlayer {
  id        String   @id @default(cuid())
  gameId    String
  name      String
  token     String   @unique
  isHost    Boolean  @default(false)
  duels     Json? // six 0/1 answers, secret until the cards are dealt
  budget    Int? // this friend's own budget; the group takes the lowest
  pick      Int?
  veto      Int?
  voted     Boolean  @default(false)
  committed Boolean  @default(false)
  joinedAt  DateTime @default(now())

  game EscapeGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

// What a finished game taught us, saved only when the host agrees. No names, no player ids, no
// link back to the game. Used to decide which routes and countries to research next.
model EscapeOutcome {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  fromState   String
  days        Int
  month       Int
  budget      Int
  reach       String
  playerCount Int
  vibe        Json
  titles      Json // the titles of the dealt cards
  winnerTitle String?
  vetoedTitles Json
  nothingFit  Boolean  @default(false)
  wish        String? // "where did you actually want to go?"
}

// A visitor's note that a visa rule looks wrong. Never edits a rule; it is a lead for a human to
// check against the official page. status: "new" | "checked" | "fixed" | "not-a-change".
model RuleReport {
  id           String   @id @default(cuid())
  passport     String
  destination  String
  heldDocument String?
  message      String
  contact      String?
  userId       String?
  status       String   @default("new")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([passport, destination])
}

// Counters behind the shared rate limiter (src/lib/rateLimitDb.ts). The key is a hash, never an
// address. Rows older than a day are swept opportunistically.
model RateLimit {
  key         String   @id
  windowStart DateTime @default(now())
  count       Int      @default(0)

  @@index([windowStart])
}
